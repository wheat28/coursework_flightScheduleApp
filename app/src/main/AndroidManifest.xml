<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.airportinfo">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Airportinfo"
        android:configChanges="locale|layoutDirection|screenSize|smallestScreenSize|orientation"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="31">

        <activity android:name=".SupportActivity"
            android:exported="false"/>

        <activity
            android:name=".FlightsListActivity"
            android:configChanges="locale|layoutDirection|screenSize|smallestScreenSize|orientation"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustPan"/>

        <activity
            android:name=".FilterActivity"
            android:exported="false" />


        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

    </application>

</manifest>
